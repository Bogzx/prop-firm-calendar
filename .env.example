# API key for the configured LLM provider.
# - Gemini (default): create a key at https://aistudio.google.com/apikey
# - OpenRouter: create a key at https://openrouter.ai/keys and set
#   [llm] provider/base_url in config.toml
LLM_API_KEY="your-key-here"

# Legacy name, still honored if LLM_API_KEY is unset:
# GEMINI_API_KEY="your-key-here"

# Optional notification channels (any combination). These are what turn the
# pull-based ICS feed into a push: you hear about a maintenance window when it
# is announced, not whenever your calendar app next polls.
# Discord: channel settings -> Integrations -> Webhooks -> New Webhook
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
# Telegram: create a bot with @BotFather, get your chat id from @userinfobot
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# TELEGRAM_CHAT_ID="123456789"
# Generic JSON webhook — Slack/Mattermost incoming webhooks, n8n, your own
# service. Receives {"text": ..., "kind": "events", "created": [...],
# "removed": [...], "anomalies": [...]}.
# WEBHOOK_URL="https://hooks.example.com/services/..."

# Docker only: host port for the published feed (compose.yaml). Defaults to 8080.
# PORT=8080
